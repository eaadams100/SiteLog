# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# Neon connection string — get this from the Neon dashboard.
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/sitelog
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.neon.tech/sitelog?sslmode=require

# Comma-separated list of allowed origins for the web dashboard (Phase 6).
# Use * only for local development, never in production.
CORS_ORIGIN=http://localhost:5173

# Optional tuning
DB_POOL_MAX=10
RATE_LIMIT_MAX=300
